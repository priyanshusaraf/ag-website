# Backend Environment Variables

# Database
DATABASE_URL=mysql://user:password@localhost:3306/agcases

# JWT
JWT_SECRET=your-very-long-random-secret-here

# REQUIRED: Admin login credentials — no defaults, server will refuse to start without these
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-admin-password

# Frontend URL (for CORS; comma-separate multiple)
FRONTEND_URL=http://localhost:3000

# Port
PORT=5000

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Andre Garcia Cases <your-email@gmail.com>
EMAIL_TO=admin@yourdomain.com

# Sentry error monitoring — optional; leave blank to disable
SENTRY_DSN=https://xxxxxx@sentry.io/xxxxxx

# Node environment
NODE_ENV=production
